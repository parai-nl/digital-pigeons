# Kopieer naar module/.env en vul in; .env is gitignored.
# Database (verplicht)
PARAI_DB_URL=postgres://parai:parai@localhost:5432/duif?sslmode=disable
# HTTP-poort (default 8080)
PORT=8080
# Alleen voor lokaal testen: bind uitsluitend aan de eigen computer.
# DUIF_BIND_HOST=127.0.0.1
# OpenAI-compatibele taalmodelproxy. Verplicht
# HTTPS, zonder gebruikersnaam, query of fragment in de URL; er is geen
# standaardadres. Budgetbewaking hoort in de proxy, niet in de module.
PARAI_LLM_BASE_URL=https://llm.example.com
PARAI_LLM_API_KEY=
# TTS en streaming-STT via de audioadapter van parai-core: alleen gezet als
# deze sleutel er is (de ElevenLabs-route).
PARAI_AUDIO_ELEVENLABS_API_KEY=

# --- Spraak: welke aanbieder en welke stem ---------------------------------
# Deze twee vlaggen kiezen de aanbieder per richting. Leeg of "elevenlabs" is
# ElevenLabs (de core-wiring hierboven); "soniox" zet de EU-route aan. Een
# andere waarde is een harde bootfout: er is geen stille terugval naar een
# andere aanbieder. Het opstartlog meldt de gekozen providers en de stem.
DUIF_STT_PROVIDER=soniox
DUIF_TTS_PROVIDER=soniox
# Eén regio-gebonden projectsleutel voor luisteren én spreken. Verplicht zodra
# een van beide vlaggen op soniox staat; ontbreekt hij, dan start de module
# niet (geen stille terugval naar ElevenLabs — dan zou vergaderaudio ongemerkt
# de EU verlaten).
SONIOX_API_KEY=
# Leeg laten is de bedoeling: het pakket kiest dan zelf de EU-endpoints
# (tts-rt.eu.soniox.com, stt-rt.eu.soniox.com). Vul alleen in om bewust naar
# een andere regio te gaan, en leg die keuze dan apart vast.
# SONIOX_TTS_HOST=
# SONIOX_STT_HOST=
# Leeg = de ingebouwde modellen (TTS tts-rt-v2).
# SONIOX_TTS_MODEL=
# SONIOX_STT_MODEL=
# De stem waarmee beide pratende duiven spreken. Bewust één stem: er is geen
# stem per duif en geen stemmenmenu voor bezoekers, dus dit is de enige plek
# waar de stem verandert. Soniox gebruikt stemnamen, geen id's; de waarden in
# personas.yaml zijn ElevenLabs-id's en betekenen op deze route niets. Niet
# gezet betekent de ingebouwde vangnetstem "Adrian", en het opstartlog
# waarschuwt daarvoor.
SONIOX_TTS_VOICE=Logan
# 1 = sprekerscheiding aanzetten in de streaming-STT.
# SONIOX_DIARIZATION=0
# Dev-only stem-id: duiven waarvan voice_id in personas.yaml nog de
# placeholder "placeholder-voice" draagt, spreken hiermee. Let op: gezet in
# productie praat élke pratende duif met deze stem; het opstartlog waarschuwt
# daarvoor.
# DUIF_DEV_VOICE_ID=

# Taalmodellen: chat, facilitator en vergaderdetectie gebruiken verplicht
# dezelfde alias. Weglaten gebruikt deze vaste waarde; een
# afwijking verhindert het opstarten.
# DUIF_CHAT_MODEL=vertex/gemini-3.6-flash-eu
# DUIF_DETECT_MODEL=vertex/gemini-3.6-flash-eu
# DUIF_MIN_SIMILARITY=0.73

# Kennisbank-import: duiven/2- of duiven/3-JSON, of een ondersteunde oudere
# ZIP-bundel. Het bestand blijft buiten Git. Maak vóór een update een
# databasebackup. De import draait bij opstart in de achtergrond; dezelfde
# bundel, mapper en embedder schrijven bij een volgende boot niets. Een gewone
# update behoudt aantoonbaar onveranderde zoekvectoren en verwijdert oude
# relaties binnen de eigen kennisbank. Een mislukte update blijft zichtbaar
# onvolledig (zie module/README.md, "Bronnen en kennisbank").
#   make import-kb KB=/pad/naar/duiven-knowledge-base.json
# DUIF_IMPORT_KB=
# 1 = vervangen in plaats van bijwerken: eerst álle rijen in de tabellen van
# deze module verwijderen (ook die van een andere kennisbank — de duif is de
# enige eigenaar), dan importeren. Bestaat bewust alleen als env, nooit via
# HTTP, en meldt zich bij het opstarten met reason=force_import. Dit is ook de
# legacy-weg na een gekrompen ZIP-bundel. Gebruik dit niet voor een normale
# update: force voorkomt het hergebruik van bestaande vectoren.
# DUIF_IMPORT_KB_FORCE=0
# Aantal parallelle schrijvers (default 6). Alleen nieuwe of gewijzigde
# embeddinginvoer kost bij een gewone update een embed-call; hoger kan eerder
# een 429 van de provider opleveren. Het log meldt per importfase de duur en
# het aantal, dus een hogere waarde is eerst te meten.
# DUIF_IMPORT_WORKERS=6
# De embedder van de kennisgraaf (core-envvars). Ze staan in de importmarker:
# wijzigt er een, dan blokkeert een volgende import zichtbaar in plaats van
# vectoren van twee modellen te mengen.
# PARAI_KNOWLEDGE_EMBEDDING_MODEL=vertex/gemini-embedding-001
# PARAI_KNOWLEDGE_EMBEDDING_DIMENSION=3072
